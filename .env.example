# 复制为 .env 并填入真实值；.env 已被 .gitignore 忽略，切勿提交密钥。
# 启动：set -a; source .env; set +a; go run ./cmd/server

# ---- 数据库 ----
MYSQL_DSN=root:<password>@tcp(127.0.0.1:3306)/jinshouzhi_v6?charset=utf8mb4&parseTime=True&loc=Local
# 仅集成测试使用：测试会派生 jinshouzhi_v6_test_<package> 库并清空重建，绝不写入 jinshouzhi_v6 本身
TEST_MYSQL_DSN=root:<password>@tcp(127.0.0.1:3306)/jinshouzhi_v6?charset=utf8mb4&parseTime=True&loc=Local
REDIS_ADDR=127.0.0.1:6379

# ---- HTTP ----
USER_HTTP_ADDR=:8080
# Admin 默认只监听本机，物理隔离；如需远程访问请置于内网/VPN 之后
ADMIN_HTTP_ADDR=127.0.0.1:8081
# 各至少 32 字节，且两者必须不同（openssl rand -hex 32）
JWT_USER_SECRET=
JWT_ADMIN_SECRET=

# ---- Vault（子账户 API Secret 加密）----
# AES-256 主密钥（base64 编码的 32 字节，openssl rand -base64 32）；可保留多个 id 以便轮换
VAULT_ACTIVE_KEY_ID=
# VAULT_KEY_<id>=

# ---- 火币 ----
HTX_SWAP_BASE_URL=https://api.hbdm.com
HTX_SPOT_BASE_URL=https://api.huobi.pro
# 母账户 Key（子账户开户、母子划转）
HUOBI_ACCESS_KEY=
HUOBI_SECRET_KEY=
HTX_MASTER_UID=
# 合约下单 Broker ID（返佣，注入下单 JSON body 的 channel_code）
HTX_SWAP_CHANNEL_CODE=AAe19e2c9d
HTX_SUBUSER_NAME_PREFIX=bv
# 子账户 API Key 必须绑定的服务器出口 IP（逗号分隔；开启开户时必填）
HTX_SUB_APIKEY_IPS=

# ---- 安全开关（火币无测试网，默认全部关闭）----
# 真实下单
HTX_TRADING_ENABLED=false
# 真实创建子账户与 API Key（火币子账户无法删除）
HTX_PROVISIONING_ENABLED=false
# 真实资金划转
HTX_TRANSFERS_ENABLED=false
